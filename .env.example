APP_NAME="Finance Tracker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://finance-tracker.test

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ==== KONEKSI DATABASE MYSQL ====
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finance_tracker
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Catatan: karena React sekarang dibangun & disajikan oleh Laravel sendiri
# (lewat Vite integration), TIDAK perlu lagi VITE_API_URL, FRONTEND_URL,
# atau SANCTUM_STATEFUL_DOMAINS terpisah -- semuanya satu domain/origin.
